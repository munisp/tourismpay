{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "TourismPay Network Observability — Cilium/Hubble Golden Signals + Security Audit",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Network Golden Signals",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(hubble_flows_processed_total{namespace=\"tourismpay\"}[1m])) by (source_workload, destination_workload)",
          "legendFormat": "{{source_workload}} → {{destination_workload}}",
          "refId": "A"
        }
      ],
      "title": "Service-to-Service Flow Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(hubble_drop_total{namespace=\"tourismpay\"}[1m])) / sum(rate(hubble_flows_processed_total{namespace=\"tourismpay\"}[1m]))",
          "legendFormat": "Drop Rate",
          "refId": "A"
        }
      ],
      "title": "Network Drop Rate (policy violations)",
      "type": "gauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(hubble_tcp_flags_total{namespace=\"tourismpay\", flag=\"SYN\"}[1m])) by (source_workload)",
          "legendFormat": "SYN from {{source_workload}}",
          "refId": "A"
        }
      ],
      "title": "TCP SYN Rate (connection attempts)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(hubble_drop_total{namespace=\"tourismpay\"}[1m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Policy Drop Reasons",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 101,
      "title": "eBPF Rate Limiter & DDoS Protection",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(tourismpay_ebpf_packets_total{action=\"total\"}[1m])",
          "legendFormat": "Total Packets",
          "refId": "A"
        },
        {
          "expr": "rate(tourismpay_ebpf_packets_total{action=\"allowed\"}[1m])",
          "legendFormat": "Allowed",
          "refId": "B"
        }
      ],
      "title": "XDP Packet Processing Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "id": 6,
      "targets": [
        {
          "expr": "tourismpay_ebpf_blacklisted_ips",
          "legendFormat": "Blacklisted IPs",
          "refId": "A"
        }
      ],
      "title": "Blacklisted IPs (auto-blocked by eBPF)",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "id": 7,
      "targets": [
        {
          "expr": "rate(tourismpay_ebpf_rate_limited_requests_total[1m])",
          "legendFormat": "Rate Limited",
          "refId": "A"
        }
      ],
      "title": "Rate Limited Requests/s",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "title": "Fraud Signal Detection (Kernel Level)",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(tourismpay_ebpf_fraud_signals_total[5m])) by (signal_type)",
          "legendFormat": "{{signal_type}}",
          "refId": "A"
        }
      ],
      "title": "eBPF Fraud Signals by Type (5m rate)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(tourismpay_ebpf_fraud_signals_total{severity=\"4\"}[5m]))",
          "legendFormat": "Critical Signals",
          "refId": "A"
        }
      ],
      "title": "Critical Fraud Signals (severity=4)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 103,
      "title": "Wallet Flow Security",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "id": 10,
      "targets": [
        {
          "expr": "sum(rate(hubble_http_requests_total{namespace=\"tourismpay\", destination_workload=\"tourismpay-server\"}[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "Wallet API Request Rate by Endpoint (Hubble L7)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["cilium", "ebpf", "tourismpay", "security", "network"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(hubble_flows_processed_total, namespace)",
        "hide": 0,
        "includeAll": false,
        "name": "namespace",
        "options": [],
        "query": "label_values(hubble_flows_processed_total, namespace)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TourismPay — Network Security (Cilium/Hubble/eBPF)",
  "uid": "tourismpay-cilium-network",
  "version": 1
}
